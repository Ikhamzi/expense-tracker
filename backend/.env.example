# Copy this file to .env for local development and fill in real values.
# On Render, set these same variables in the service's Environment tab instead.

# Neon Postgres connection string (Neon dashboard > your project > Connection Details).
# Make sure it includes ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/expense_tracker?sslmode=require

# Any long random string - used to sign our own login tokens (not Google's).
JWT_SECRET_KEY=replace-with-a-long-random-string

# Google OAuth Client ID from Google Cloud Console (must match the frontend's
# VITE_GOOGLE_CLIENT_ID exactly).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# The URL your frontend runs on, used to allow it through CORS.
FRONTEND_ORIGIN=http://localhost:5173
